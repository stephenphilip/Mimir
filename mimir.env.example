# Mimir local environment (copy to mimir.env and customize)
# Windows PowerShell: Get-Content mimir.env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process') } }

# Image generation — use ComfyUI (local) or openai (cloud)
MIMIR_IMAGE_PROVIDER=comfyui
MIMIR_COMFYUI_URL=http://127.0.0.1:8188

# Cloud alternative (uncomment and set key):
# MIMIR_IMAGE_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# Ollama (default)
MIMIR_OLLAMA_URL=http://localhost:11434
